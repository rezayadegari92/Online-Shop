# Database Configuration
POSTGRES_DB=onlineshop
POSTGRES_USER=onlineshop
POSTGRES_PASSWORD=onlineshop
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1
ALLOWED_HOSTS=*

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=45
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Configuration
REDIS_URL=redis://redis:6379/1

# Frontend Configuration
VITE_BACKEND_URL=http://web:8000

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Postgres Exporter Configuration
DATA_SOURCE_NAME=postgresql://onlineshop:onlineshop@db:5432/onlineshop?sslmode=disable
